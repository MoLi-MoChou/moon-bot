# Keep LF in the working tree on Windows so Biome format:check matches Linux CI.
# Without this, Git's default autocrlf on windows-latest turns every file into CRLF
# and `biome format` reports hundreds of false failures.
* text=auto eol=lf

# Shell scripts are copied into the Docker image as they are; CRLF breaks them.
*.sh text eol=lf

