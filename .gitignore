node_modules/
*.tgz
# The desktop app's window build and bundled main (pnpm --filter moon-bot run build), its packages
# (pack/dist) and the next version that checks its update (see apps/desktop/README.md).
/apps/desktop/ui/dist/
/apps/desktop/dist-main/
/apps/desktop/dist-pack/
/apps/desktop/dist-next/

# A DeepSeek Harness checkout for the tests and the test bench.
/deepseek-harness/

# Test bench, local DSH data and the screenshots of dev/check.sh.
.dsh-test*/
.dsh-home/
/shots/
.playwright-mcp/

# Extra patterns for scripts/scan.mjs that must not be named in the repository.
.scan-extra

# Local Docker deployment data.
/docker/data/
/docker/workspace/
/docker/.env
/.env
/docker-compose.override.yml

# core/contracts/ui generated artifacts (built by the root postinstall and `pnpm run build`; never
# committed — see scripts/postinstall.mjs).
/packages/core/client.js
/packages/core/index.js
/packages/core/web-search.js
/packages/core/dist/
/packages/contracts/dist/
/packages/ui/dist/

# The mock bench (dev/bench.sh) keeps its team beside the checkout.
/.moon-bot-test-*/

# The published connect CLI is bundled by `pnpm run build` (apps/connect/scripts/build.mjs).
/apps/connect/dist/

# Other package managers' locks (repo uses pnpm-lock.yaml only; see packageManager)
package-lock.json
npm-shrinkwrap.json
yarn.lock
