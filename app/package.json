{
  "name": "moon-bot",
  "productName": "Moon Bot",
  "version": "0.2.1",
  "private": true,
  "description": "Moon Bot desktop and web app: the Bot team on Moon Bot's own runtime.",
  "author": "MoLi-MoChou",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build-main.ts",
    "build:main": "node scripts/build-main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "start": "electron .",
    "pack": "node scripts/rebuild-native.mjs && electron-builder --dir --publish never",
    "dist": "node scripts/rebuild-native.mjs && electron-builder --publish never",
    "check-packed": "node scripts/check-packed.mjs",
    "shot": "node scripts/shot.mjs",
    "icon": "python3 scripts/icon.py",
    "test": "node --test \"test/*.test.mjs\"",
    "web": "node src/web.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "moon-bot-core": "*",
    "pnpm": "11.7.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/react-dom": "^19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.14",
    "@rolldown/binding-win32-x64-msvc": "1.2.14",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
