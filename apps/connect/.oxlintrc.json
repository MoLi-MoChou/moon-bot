{
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error"
  }
}
