{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "**/*.css",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-main",
      "!**/dist-pack",
      "!**/dist-next",
      "!**/ui/dist",
      "!**/coverage",
      "!**/.dsh-test*",
      "!**/.moon-bot-test*",
      "!pnpm-lock.yaml",
      "!package-lock.json",
      "!yarn.lock",
      "!packages/core/client.js",
      "!packages/core/index.js",
      "!packages/core/web-search.js",
      "!**/tsconfig*.json",
      "!**/*.tsbuildinfo",
      "!**/vendor/**",
      "!packages/contracts/src/rpc.ts",
      "!packages/contracts/src/views/validate.ts",
      "!packages/core/src/client/bot-browsers.ts",
      "!packages/core/src/client/browser-pane-chrome.tsx",
      "!packages/core/src/client/browser-pane.tsx",
      "!packages/core/src/client/characters.ts",
      "!packages/core/src/client/client-actions.ts",
      "!packages/core/src/client/client-boot.ts",
      "!packages/core/src/client/connector-market.tsx",
      "!packages/core/src/client/deliver-cards.tsx",
      "!packages/core/src/client/files-panel.ts",
      "!packages/core/src/client/index.ts",
      "!packages/core/src/client/member-status.tsx",
      "!packages/core/src/client/memory-panel.tsx",
      "!packages/core/src/client/model-menu.tsx",
      "!packages/core/src/client/new-chat.tsx",
      "!packages/core/src/client/questions.tsx",
      "!packages/core/src/client/read-page.ts",
      "!packages/core/src/client/sidebar-rows.tsx",
      "!packages/core/src/client/tasks-page.tsx",
      "!packages/core/src/client/text.ts",
      "!packages/core/src/client/themes.ts",
      "!packages/core/src/client/usage-charts.tsx",
      "!packages/core/src/client/usage-page.tsx",
      "!packages/core/src/client/voice.tsx",
      "!packages/core/src/client/widget-cell.tsx",
      "!packages/core/src/client/work-process.tsx",
      "!packages/core/src/engine/acp/runtime.ts",
      "!packages/core/src/host/browser.ts",
      "!packages/core/src/host/capabilities-mount.ts",
      "!packages/core/src/host/capabilities.ts",
      "!packages/core/src/host/channel/ops-team.ts",
      "!packages/core/src/host/chat-index.ts",
      "!packages/core/src/host/diagnostics.ts",
      "!packages/core/src/host/groups.ts",
      "!packages/core/src/host/groups/log.ts",
      "!packages/core/src/host/groups/rounds.ts",
      "!packages/core/src/host/memory.ts",
      "!packages/core/src/host/memory/news.ts",
      "!packages/core/src/host/memory/prompt.ts",
      "!packages/core/src/host/memory/recall.ts",
      "!packages/core/src/host/memory/storage.ts",
      "!packages/core/src/host/parts-switch-move.ts",
      "!packages/core/src/host/parts-switch.ts",
      "!packages/core/src/host/parts.ts",
      "!packages/core/src/host/providers.ts",
      "!packages/core/src/host/roster-rooms.ts",
      "!packages/core/src/host/roster.ts",
      "!packages/core/src/host/secrets/install.ts",
      "!packages/core/src/host/store.ts",
      "!packages/core/src/host/tasks-panel.ts",
      "!packages/core/src/host/tools/chat-tools.ts",
      "!packages/core/src/host/tools/shared.ts",
      "!packages/core/src/host/turns/delivery.ts",
      "!packages/core/src/host/turns/route.ts",
      "!packages/core/src/host/usage/view.ts",
      "!packages/core/src/service/engine.ts",
      "!packages/core/src/service/llm.ts",
      "!packages/core/src/store/proactive.ts",
      "!packages/core/src/web-search/provider.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded",
      "bracketSameLine": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
