{
  "name": "moon-bot-core",
  "version": "0.1.4",
  "description": "Moon Bot: the Bot team inside the Moon Bot app (a slim fork of DS Bot by Fei2411, Apache-2.0)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/MoLi-MoChou/moon-bot#readme",
  "bugs": {
    "url": "https://github.com/MoLi-MoChou/moon-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoLi-MoChou/moon-bot.git",
    "directory": "core"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "dist/",
    "client.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.ts && node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\" \"test/*.test.ts\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh",
    "test:gate": "node scripts/test-gate.mjs",
    "build:host": "node scripts/build-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.2",
    "framer-motion": "^12.43.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  }
}
