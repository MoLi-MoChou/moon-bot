{
  "name": "moon-bot-core",
  "version": "0.2.2",
  "description": "Moon Bot: the Bot team, its own runtime (a slim fork of DS Bot by Fei2411, Apache-2.0)",
  "keywords": [
    "bot",
    "multi-agent",
    "agents",
    "personal-agent",
    "sqlite"
  ],
  "homepage": "https://github.com/MoLi-MoChou/moon-bot#readme",
  "bugs": {
    "url": "https://github.com/MoLi-MoChou/moon-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoLi-MoChou/moon-bot.git",
    "directory": "core"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json",
    "./service": "./dist/service/server.js"
  },
  "files": [
    "index.js",
    "dist/",
    "client.js",
    "web-search.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.ts && node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.ts\"",
    "test:related": "node scripts/test-related.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "sh dev/check.sh",
    "test:gate": "node scripts/test-gate.mjs",
    "build:host": "node scripts/build-host.mjs",
    "eval": "node scripts/eval.ts",
    "doctor": "node dev/engine-doctor.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.2",
    "framer-motion": "^12.43.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@oxlint/binding-win32-x64-msvc": "1.76.0"
  }
}
