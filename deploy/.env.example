# Copy to .env (chmod 600) beside this compose file. update.sh/rollback.sh rewrite
# MOON_BOT_TAG; everything else is yours.
MOON_BOT_PASSWORD=choose-a-strong-one
# The image tag: a short sha, `main`, `latest`, or vX.Y.Z.
MOON_BOT_TAG=latest
# Optional: a registry other than GHCR.
# MOON_BOT_REGISTRY=ghcr.io/moli-mochou/moon-bot
# Optional: a host port other than 8290.
# MOON_BOT_PORT=8290
# Optional: a container name other than moon-bot (a second instance on this host).
# MOON_BOT_CONTAINER=moon-bot
# Snapshots are stored below this deployment directory and pruned after this many updates.
# MOON_BOT_SNAPSHOT_DIR=.snapshots
# MOON_BOT_SNAPSHOT_RETENTION=5
# Model provider keys, as the service reads them.
# SENSENOVA_API_KEY=
