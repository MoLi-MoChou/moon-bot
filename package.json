{
  "name": "moon-bot-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Moon Bot: the core package and the desktop/web app, as npm workspaces.",
  "workspaces": [
    "core",
    "app"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint -w moon-bot-core",
    "eval": "npm run eval -w moon-bot-core"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "protobufjs": true,
    "electron-winstaller": true,
    "@google/genai": true
  }
}
