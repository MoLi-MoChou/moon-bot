{
  "name": "moon-bot-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Moon Bot: pnpm workspace with apps/* (desktop, connect) and packages/* (core, contracts).",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=10.18.3"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "eval": "pnpm --filter moon-bot-core run eval",
    "lint": "pnpm --filter moon-bot-core run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "protobufjs",
      "electron-winstaller",
      "@google/genai",
      "electron"
    ]
  }
}
